generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  ADMIN
  USER
}
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}
enum Plan {
  FREE
  PROFESSIONAL
  PRO
  BUSINESS
}
enum SubscriptionStatus {
  INACTIVE
  PENDING
  ACTIVE
  PAUSED
  CANCELED
  PAYMENT_FAILED
}
enum CertificateStatus {
  DRAFT
  ISSUED
  VOID
}
enum ServicePaymentStatus {
  NO_AMOUNT
  PENDING
  PARTIAL
  PAID
}
enum ServicePaymentMethod {
  CASH
  BANK_TRANSFER
  MERCADO_PAGO
  DEBIT_CARD
  CREDIT_CARD
  CHECK
  OTHER
}
enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}
enum WorkOrderStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  WAITING_PART
  COMPLETED
  CANCELED
}
enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}
enum ContractStatus {
  ACTIVE
  PAUSED
  ENDED
}
enum NotificationType {
  WORK_ORDER
  SERVICE_DUE
  PAYMENT
  SYSTEM
}
enum LegalRequestType {
  WITHDRAWAL
  CANCELLATION
  PRIVACY
}
enum LegalRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  name                 String
  role                 AppRole        @default(USER)
  activeOrganizationId String?
  activeOrganization   Organization?  @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  memberships          Membership[]
  createdCertificates  Certificate[]  @relation("CertificateCreator")
  servicePayments      CertificatePayment[]
  teamInvites          TeamInvite[]   @relation("InviteCreator")
  legalRequests        LegalRequest[]
  resetTokens          PasswordResetToken[]
  sessions             Session[]
  createdWorkOrders    WorkOrder[] @relation("WorkOrderCreator")
  assignedWorkOrders   WorkOrder[] @relation("WorkOrderAssignee")
  notifications        Notification[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  @@index([activeOrganizationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Organization {
  id                      String             @id @default(cuid())
  name                    String
  legalName               String?
  cuit                    String?
  email                   String?
  phone                   String?
  address                 String?
  logoUrl                 String?
  publicSlug              String             @unique
  plan                    Plan               @default(FREE)
  monthlyCertificateLimit Int                @default(5)
  subscriptionStatus      SubscriptionStatus @default(INACTIVE)
  mpSubscriptionId        String?            @unique
  mpPayerEmail            String?
  subscriptionCurrentEnd  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  memberships             Membership[]
  activeUsers             User[]             @relation("ActiveOrganization")
  clients                 Client[]
  certificates            Certificate[]
  subscriptionPayments    SubscriptionPayment[]
  teamInvites             TeamInvite[]
  legalRequests           LegalRequest[]
  assets                  Asset[]
  workOrders              WorkOrder[]
  serviceTemplates        ServiceTemplate[]
  quotes                  Quote[]
  maintenanceContracts    MaintenanceContract[]
  notifications           Notification[]
}

model Membership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role MembershipRole @default(MEMBER)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([organizationId,userId])
  @@index([userId])
}

model Client {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  name String
  email String?
  phone String?
  taxId String?
  address String?
  notes String?
  portalCode String? @unique
  assets Asset[]
  workOrders WorkOrder[]
  quotes Quote[]
  maintenanceContracts MaintenanceContract[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  certificates Certificate[]
  @@index([organizationId,name])
}

model Certificate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  clientId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  assetId String?
  asset Asset? @relation(fields:[assetId],references:[id],onDelete:SetNull)
  workOrderId String? @unique
  workOrder WorkOrder? @relation(fields:[workOrderId],references:[id],onDelete:SetNull)
  createdByUserId String
  createdBy User @relation("CertificateCreator",fields:[createdByUserId],references:[id],onDelete:Restrict)
  sequentialNumber Int
  code String @unique
  status CertificateStatus @default(ISSUED)
  serviceTitle String
  description String @db.Text
  observations String? @db.Text
  technicianName String?
  serviceAddress String?
  performedAt DateTime @default(now())
  nextServiceAt DateTime?
  warrantyUntil DateTime?
  reminderSentAt DateTime?
  signatureDataUrl String? @db.Text
  signatureName String?
  customerAcceptedAt DateTime?
  totalAmountCents BigInt?
  currency String @default("ARS")
  paymentStatus ServicePaymentStatus @default(NO_AMOUNT)
  paymentDueDate DateTime?
  paymentReminderSentAt DateTime?
  paymentNotes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos CertificatePhoto[]
  servicePayments CertificatePayment[]
  @@unique([organizationId,sequentialNumber])
  @@index([organizationId,performedAt])
  @@index([organizationId,paymentStatus])
  @@index([assetId])
  @@index([workOrderId])
  @@index([nextServiceAt,reminderSentAt])
  @@index([paymentDueDate,paymentReminderSentAt])
}

model CertificatePhoto {
  id String @id @default(cuid())
  certificateId String
  certificate Certificate @relation(fields:[certificateId],references:[id],onDelete:Cascade)
  storageKey String @db.Text
  label String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
}

model CertificatePayment {
  id String @id @default(cuid())
  certificateId String
  certificate Certificate @relation(fields:[certificateId],references:[id],onDelete:Cascade)
  amountCents BigInt
  method ServicePaymentMethod
  paidAt DateTime @default(now())
  reference String?
  notes String? @db.Text
  createdByUserId String?
  createdBy User? @relation(fields:[createdByUserId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([certificateId,paidAt])
}

model SubscriptionPayment {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  provider String @default("mercadopago")
  providerPaymentId String @unique
  amountCents BigInt
  currency String @default("ARS")
  status String
  raw Json?
  paidAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}

model TeamInvite {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  email String
  role MembershipRole @default(MEMBER)
  token String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdByUserId String
  createdBy User @relation("InviteCreator",fields:[createdByUserId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([organizationId,email])
  @@index([token])
}

model LegalRequest {
  id String @id @default(cuid())
  organizationId String?
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull)
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  type LegalRequestType
  status LegalRequestStatus @default(OPEN)
  email String
  name String?
  organizationName String?
  description String? @db.Text
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status,createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}



model Asset {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  assetNumber Int
  publicCode String @unique
  name String
  category String?
  brand String?
  model String?
  serialNumber String?
  location String?
  notes String? @db.Text
  status AssetStatus @default(ACTIVE)
  installedAt DateTime?
  warrantyUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  certificates Certificate[]
  workOrders WorkOrder[]
  maintenanceContracts MaintenanceContract[]
  @@unique([organizationId,assetNumber])
  @@index([organizationId,clientId])
  @@index([organizationId,name])
  @@index([serialNumber])
}

model ServiceTemplate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  name String
  category String?
  defaultTitle String
  defaultDescription String @db.Text
  checklist Json?
  defaultDurationMinutes Int?
  defaultNextServiceDays Int?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workOrders WorkOrder[]
  @@index([organizationId,name])
}

model WorkOrder {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  sequentialNumber Int
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  assetId String?
  asset Asset? @relation(fields:[assetId],references:[id],onDelete:SetNull)
  templateId String?
  template ServiceTemplate? @relation(fields:[templateId],references:[id],onDelete:SetNull)
  createdByUserId String
  createdBy User @relation("WorkOrderCreator",fields:[createdByUserId],references:[id],onDelete:Restrict)
  assignedUserId String?
  assignedUser User? @relation("WorkOrderAssignee",fields:[assignedUserId],references:[id],onDelete:SetNull)
  status WorkOrderStatus @default(SCHEDULED)
  priority WorkOrderPriority @default(NORMAL)
  title String
  description String @db.Text
  serviceAddress String?
  scheduledStart DateTime?
  scheduledEnd DateTime?
  startedAt DateTime?
  completedAt DateTime?
  internalNotes String? @db.Text
  checklistResults Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  certificate Certificate?
  materials WorkOrderMaterial[]
  @@unique([organizationId,sequentialNumber])
  @@index([organizationId,status,scheduledStart])
  @@index([assignedUserId,scheduledStart])
  @@index([assetId])
}

model WorkOrderMaterial {
  id String @id @default(cuid())
  workOrderId String
  workOrder WorkOrder @relation(fields:[workOrderId],references:[id],onDelete:Cascade)
  name String
  quantity Decimal @db.Decimal(12,3)
  unit String?
  unitCostCents BigInt?
  createdAt DateTime @default(now())
  @@index([workOrderId])
}

model Quote {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  sequentialNumber Int
  status QuoteStatus @default(DRAFT)
  title String
  notes String? @db.Text
  validUntil DateTime?
  currency String @default("ARS")
  totalAmountCents BigInt @default(0)
  publicCode String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items QuoteItem[]
  @@unique([organizationId,sequentialNumber])
  @@index([organizationId,status,createdAt])
}

model QuoteItem {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
  description String
  quantity Decimal @db.Decimal(12,3)
  unitPriceCents BigInt
  sortOrder Int @default(0)
}

model MaintenanceContract {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  assetId String?
  asset Asset? @relation(fields:[assetId],references:[id],onDelete:SetNull)
  name String
  status ContractStatus @default(ACTIVE)
  frequencyDays Int
  startAt DateTime
  endAt DateTime?
  nextVisitAt DateTime?
  monthlyAmountCents BigInt?
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,status,nextVisitAt])
}

model Notification {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
  type NotificationType
  title String
  body String @db.Text
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
  @@index([userId,readAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
